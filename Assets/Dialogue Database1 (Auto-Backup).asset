    - id: 31
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Lust is a devil who embodies the greatest of human desires. He believes
          that all actions, at their roots, are a result of the truest human desire:
          power. The yearning for control, for power over another in the most complete
          way possible...  That is the embodiment of the Devil of Lust.  '
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
