        type: 0
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: 'One day my Church sends me out with my team to handle a strange sign
          in a small village.  So we went into this village.  And my teammember named
          Carl.  Decided to be blunt and pressed this one villager so hard that it
          turned out to be skin-walker.  '
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 49
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 49
        originDialogueID: 52
        destinationConversationID: 49
        destinationDialogueID: 54
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 1840.48
        y: 1154.2324
        width: 160
        height: 30
    - id: 54
      fields:
