        width: 160
        height: 30
    - id: 34
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "This devil takes from those who want something from others. This
          desire could be physical possessions or something as ephemeral as love.
          In truth, it doesn\u2019t matter, because she will never give the wisher
          what they truly want. She hates mortals for their unique gifts given to
          them by the Owl himself."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
