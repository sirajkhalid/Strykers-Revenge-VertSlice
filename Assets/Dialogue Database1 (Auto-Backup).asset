      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Oh I do love young learners.  Our church usually handles funerals,
          grief therapy, and helping the world by putting wandering souls or aggrevated
          souls like ghouls or skeletions to rest.  I would explain the rest but
          we would be here for awhile and can't keep the queen waiting.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 48
