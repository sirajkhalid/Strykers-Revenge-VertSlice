        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Hohoho - nervous?  I don't blame you.  But Im not a priest of death
          - Im a priest of the Lady.  Im sure your town has said that I do human
          sarcfices or some other none sense.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
