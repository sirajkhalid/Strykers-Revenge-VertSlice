        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I was happy when we had the old council members removed. All they
          did was want the old ways, and the old ways were... awful. But this violence\u2014it's
          just the same violence directed at criminals, but not in a way that feels
          righteous. It feels vindictive."
        type: 0
