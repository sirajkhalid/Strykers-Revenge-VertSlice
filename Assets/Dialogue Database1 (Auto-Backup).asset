        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Thank you for coming.  As you know my name is Queen Sapphire of the
          Tyra kingdom.  I have summoned you all here for a crucial mission, one
          that my soldiers have not been able to complete.  (The room erupts in murmurs
          and doubts)
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
