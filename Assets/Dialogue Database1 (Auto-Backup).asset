        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Ah good to be home...  Greetings - mercs.  My name is Styrker and
          I'm here to give you all a chance to resolve some matters peacefully.
        type: 0
        typeString: CustomFieldType_Text
