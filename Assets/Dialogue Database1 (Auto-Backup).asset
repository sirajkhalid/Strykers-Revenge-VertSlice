      - title: Dialogue Text
        value: Ah the palace of Tyra.  A beautiful marvel and I been in some of beautiful
          churches with some of the best craftmanship but the amount of gold is new
          for me.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 48
      isRoot: 0
