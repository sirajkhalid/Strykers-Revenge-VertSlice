        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "The rebels broke through\u2014DAMN IT ALL. I don't know how, but
          Styrker figured out how to break the collars! (Just my luck.) Well, I'm
          not going to die here\u2014I REFUSE to. (The letter ends with a smear of
          blood.)"
        type: 0
