        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Words and negotiations, but I understand that doesn't always work...
          So if need be\u2014force. That is why right now, right here, you all have
          a choice, including you\u2014your \"majesty\"\u2014to choose peace or face
          the hand of righteous judgement."
        type: 0
