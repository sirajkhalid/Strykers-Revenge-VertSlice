        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "The king was pleased that we finally got our first successful subject
          and have been creating more Runic Dwarf super soldiers. Turning a defect
          into a useful tool! I'm surprised the first successful test subject was
          his own son\u2014harsh, but I'm just glad it's not at my beck and call."
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
