        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: (She freezes when she stares at your eyes.  Her fear is taking hold
          and she failed to keep it in check) (She coughs trying to hold her expression
          back together though her hands still shake)
        type: 0
