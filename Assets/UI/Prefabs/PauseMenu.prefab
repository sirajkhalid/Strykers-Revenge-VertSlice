  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 In and outside of combat you can switch party members\n\n\u2022
    Switching during combat costs a bonus action\n\n\u2022 The new active member
    will not have a bonus action but will have a regular action\n\n\u2022 Dying during
    combat will automatically switch you to the next available alive party member"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
  m_sharedMaterial: {fileID: 2140032, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
