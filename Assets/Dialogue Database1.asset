      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'The Great Annihilation was an event of continent genocide of all
          races.  The God of Free Will angered by the God of Tyranny maniplutation
          of mortals blamed them for the death of his lover. '
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
      isGroup: 0
      nodeColor: 
