      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: It's been a week since - I was thrown into these labs.  I seen 10
          people die and heard screaming non-stop for the past 24- hours.  I have
          vomitted 3 times today from the sound alone.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 33
      isRoot: 0
      isGroup: 0
