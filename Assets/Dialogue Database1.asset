      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Most demons are just minions - not with much thought besides killing,
          eating, and obeying the stronger.  However, more and more demons are starting
          to use maniplutation and scheming to either please their masters or gain
          power themselves.

'
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
      isGroup: 0
      nodeColor: 
