    - id: 1
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "The Great Annihilation was an event of continental genocide of all
          races.  The God of Free Will, angered by the God of Tyranny\u2019s manipulation
          of mortals, blamed those same mortals for the death of his lover. "
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: 
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 5
        originDialogueID: 1
        destinationConversationID: 5
        destinationDialogueID: 3
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 134.15692
        y: 119.45526
        width: 160
        height: 30
    - id: 3
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Though who can really resist a god? Though the god\u2019s logic was
          flawed, he still attacked the first Continent with his forces laying waste
          to all.  The Human and Elven kingdoms fell and it was only thanks to Marble
          Monts, a great dwarfen warrior, that we all survived. She is the on who
          slayed the herald of the evil god to save us all."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 5
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: 
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 5
        originDialogueID: 3
        destinationConversationID: 5
        destinationDialogueID: 4
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 100
        y: 204.66667
        width: 160
        height: 30
